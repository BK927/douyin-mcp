# Copy values into the environment of your MCP client; .env is not loaded automatically.
# Use distinct MCP instances and STATE_DIRs for mobile/web and mini-app grants.
DOUYIN_APP_TYPE=mobile_web
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=
DOUYIN_OPEN_ID=
DOUYIN_CLIENT_TOKEN=
DOUYIN_BUSINESS_TOKEN=
# Only list permissions actually approved for this app/account. This does not grant scopes.
DOUYIN_SCOPES=
# Official public search requires your genuine device ID, not a fabricated value.
DOUYIN_DEVICE_ID=
# Defaults to ~/.douyin-mcp. Keep this private and outside a Git checkout.
DOUYIN_STATE_DIR=
DOUYIN_ENABLE_WRITES=false
# An absolute directory containing only media approved for upload.
DOUYIN_MEDIA_DIR=
DOUYIN_ENABLE_BROWSER=false
DOUYIN_BROWSER_HEADLESS=false
